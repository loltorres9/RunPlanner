# Wird auf Railway automatisch gesetzt, sobald der Dienst mit Postgres verknüpft ist:
DATABASE_URL=postgres://runplanner:runplanner@localhost:5432/runplanner

# Für den Website-Import (https://console.anthropic.com → API Keys). Ohne ihn ist der Import aus.
ANTHROPIC_API_KEY=

# Optional:
# ANTHROPIC_MODEL=claude-opus-5-5
# IMPORTS_PER_HOUR=30
# TOKEN_SECRET=   # sonst wird eines erzeugt und in der Datenbank abgelegt
